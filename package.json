{
  "name": "panu-net-v2-server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run sentry:sourcemaps && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/services/queue-system/workers/subscription-expiry-worker.ts",
    "dev:debug": "tsx --inspect-brk src/index.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/services/queue-system/workers/subscription-expiry-worker.js",
    "start:prod": "node dist/bundle.js",
    "lint": "eslint . --config eslint.config.ts",
    "format": "prettier --write src/",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:migrate:with-ts": "node scripts/drizzle-migrate-with-ts-imports.js",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org panu-teknoloji --project panu-net-v2-server ./dist && sentry-cli sourcemaps upload --org panu-teknoloji --project panu-net-v2-server ./dist"
  },
  "keywords": [],
  "author": "Can Komusdogan",
  "license": "ISC",
  "description": "",
